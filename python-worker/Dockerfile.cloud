# Build from repository root:
# docker build -f python-worker/Dockerfile.cloud -t minz-cloud-media:dev .
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg \
    HOME=/tmp \
    CLOUD_MEDIA_RUN_ENABLED=false

RUN apt-get update && apt-get install --no-install-recommends -y \
      ca-certificates ffmpeg fontconfig fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/minz/python-worker
COPY python-worker/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.txt
COPY python-worker/src ./src
COPY python-worker/cloud_media_job.py ./cloud_media_job.py

RUN mkdir -p /work/temp /work/outputs && chown -R 10001:10001 /work
USER 10001
WORKDIR /work
ENV PYTHONPATH=/opt/minz/python-worker

ENTRYPOINT ["python", "/opt/minz/python-worker/cloud_media_job.py"]
